{
  "name": "fusheng-millennia",
  "productName": "浮生千年",
  "version": "0.2.0",
  "description": "浮生千年：中華歷史人生養成（Windows 桌面版）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync": "node sync.js",
    "start": "node sync.js && electron .",
    "pack": "node sync.js && electron-packager . FushengMillennia --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=\"^/dist\" --ignore=\"^/sync.js\" --ignore=\"^/README.md\""
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "@electron/packager": "^18.3.6"
  }
}
